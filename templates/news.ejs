<%
const fmt = d => { const x = new Date(d); return isNaN(x) ? String(d || '') : x.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }); };
%>
<div class="news-list">
<% for (const n of items) { %>
<div class="news-item">
<div class="news-date"><%= fmt(n.date) %></div>
<div>
<h3><% if (n.link) { %><a href="<%= n.link %>"><%= n.title %></a><% } else { %><%= n.title %><% } %></h3>
<p><%= n.text %></p>
<% if (n.image) { %><img src="<%= n.image %>" alt=""><% } %>
</div>
</div>
<% } %>
</div>
